# Public site URL — used for canonical links, sitemap, OG image, and JSON-LD.
# In Railway, set this to your final domain (e.g. https://golivio.com) once DNS is wired.
NEXT_PUBLIC_SITE_URL=https://golivio.com

# Anthropic API key for the /api/ask "Ask Livio" route.
# Optional: if unset, the route returns 503 and the client falls back to
# on-page keyword search. Set it in Railway -> Variables to enable LLM answers.
ANTHROPIC_API_KEY=
